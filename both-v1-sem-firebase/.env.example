# Both.AI - environment variables

# Facebook App credentials (Meta for Developers)
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret

# WhatsApp Cloud API
WHATSAPP_TOKEN=your_whatsapp_permanent_token
# Token used by Meta to verify the webhook (GET /webhook)
VERIFY_TOKEN=both-ai-v1-nois

# Server
PORT=3000
